{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cache-investigator",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },
  "d1_databases": [
    {
      "binding": "TELEMETRY_DB",
      "database_name": "cache-investigator-telemetry",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "InvestigationAgent",
        "name": "InvestigationAgent"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["InvestigationAgent"],
      "tag": "v1"
    }
  ]
}
