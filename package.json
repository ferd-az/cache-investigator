{
  "name": "cache-investigator",
  "version": "1.0.0",
  "private": true,
  "description": "A Cloudflare-based agent for investigating cache regressions",
  "keywords": [
    "agents",
    "ai",
    "cloudflare"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "simulator:validate": "node --experimental-strip-types --test simulator/generator.test.ts",
    "telemetry:seed:local": "node --experimental-strip-types simulator/seed-d1.ts --local",
    "fixtures:series": "node --experimental-strip-types --disable-warning=ExperimentalWarning simulator/export-fixture-series.ts && oxfmt --write src/fixtures/telemetry-series.ts",
    "telemetry:validate": "node --experimental-strip-types --test src/telemetry/tools.integration.test.ts",
    "model:validate": "node --experimental-strip-types --test src/investigation/anthropic-model.test.ts",
    "investigation:validate": "node --experimental-strip-types --test src/investigation/runtime.integration.test.ts",
    "presentation:validate": "node --experimental-strip-types --test src/investigation/signal-data.test.ts",
    "types": "wrangler types env.d.ts",
    "format": "oxfmt --write .",
    "lint": "oxlint src/ simulator/",
    "check:fast": "oxfmt --check . && npm run lint && tsc && npm run simulator:validate && npm run model:validate && npm run presentation:validate",
    "check": "npm run check:fast && npm run telemetry:validate && npm run investigation:validate"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "agents": "^0.17.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^13.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@cloudflare/vite-plugin": "^1.46.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "miniflare": "5.20260826.0-alpha",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "wrangler": "^4.113.0"
  },
  "allowScripts": {
    "core-js-pure@3.49.0": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260721.1": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true
  }
}
